# Copy this file to an untracked .env and replace every example value.
# The development defaults keep durable workers disabled. Production requires
# the complete provider, database, tokenizer, CORS, and trusted-ingress set.

APP_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
UVICORN_WORKERS=1

# Keep these equal. Set both to true only after the schema and providers are ready.
RUNTIME_WORKER_ENABLED=false
PROJECTION_WORKER_ENABLED=false
RUNTIME_WORKER_ID=docreview-local-1

# PostgreSQL. This value is not used by database-free tests.
DATABASE_URL=postgresql://user:change-me@localhost:5432/docreview
DATABASE_MIN_SIZE=2
DATABASE_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# SiliconFlow/OpenAI-compatible provider configuration.
SILICONFLOW_API_KEY=replace-with-provider-key
SILICONFLOW_BASE_URL=https://provider.example/v1
LLM_MODEL=replace-with-chat-model
EMBEDDING_MODEL=replace-with-embedding-model
EMBEDDING_DIM=1024
RERANKER_MODEL=replace-with-reranker-model
LLM_TIMEOUT_MS=90000
LLM_RETRY_MAX=2
LLM_RETRY_BACKOFF_MS=1000

# Production document ingestion uses the bounded structured parser.
DOCUMENT_PARSER=structured
CHUNK_PROFILE=docreview-review-structure-2026-08-17
EMBEDDING_TOKENIZER_PROFILE=replace-with-approved-tokenizer-profile
# EMBEDDING_TOKENIZER_PATH=C:/opt/docreview/tokenizers/approved-tokenizer.json
TIKA_URL=http://tika.example:9998
TIKA_TIMEOUT_MS=45000

# Local content-addressed upload storage. Use an absolute path outside the repo in production.
UPLOAD_STORAGE_DIR=./data/uploads
UPLOAD_MAX_BYTES=20971520

# Optional. Leave URL and API key unset to disable Web Search and omit its tool.
# WEB_SEARCH_URL=https://search.example/v1
# WEB_SEARCH_API_KEY=replace-with-search-key
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_MAX_RESULTS=5

# Trusted ingress HMAC attestation. Keep the secret in a secret manager in production.
AGENT_RUNTIME_TRUSTED_INGRESS_HMAC_SECRET=replace-with-at-least-32-byte-secret-value
AGENT_RUNTIME_TRUSTED_INGRESS_SOURCE=local-proxy
AGENT_RUNTIME_TRUSTED_INGRESS_MAX_AGE_MS=300000
