load_module modules/ngx_http_js_module.so;

env AGENT_RUNTIME_TRUSTED_INGRESS_HMAC_SECRET;

worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 4096;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;

    js_import trusted from /etc/nginx/trusted_ingress.js;

    map $http_x_request_id $trusted_request_id {
        ~^[A-Za-z0-9._:-]{1,128}$ $http_x_request_id;
        default $request_id;
    }

    upstream docreview_python {
        zone docreview_python 64k;
        server ${DOCREVIEW_PYTHON_UPSTREAM}:8080 max_fails=2 fail_timeout=10s;
        keepalive 64;
    }

    upstream identity_authorizer {
        zone identity_authorizer 32k;
        server ${DOCREVIEW_AUTH_UPSTREAM}:8443 max_fails=2 fail_timeout=10s;
        keepalive 32;
    }

    server {
        listen 443 ssl http2;
        server_name ${DOCREVIEW_PUBLIC_SERVER_NAME};

        ssl_certificate /run/secrets/tls_certificate;
        ssl_certificate_key /run/secrets/tls_private_key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        client_max_body_size 20m;
        client_body_timeout 30s;
        keepalive_timeout 65s;
        send_timeout 300s;

        location = /_identity_authorize {
            internal;
            proxy_pass https://identity_authorizer/v1/docreview/authorize;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Original-Method $request_method;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header X-Request-ID $trusted_request_id;

            # Never let caller-provided trusted identity reach the authorizer.
            proxy_set_header X-DocReview-Principal-Type "";
            proxy_set_header X-DocReview-Principal-ID "";
            proxy_set_header X-DocReview-Organization-ID "";
            proxy_set_header X-DocReview-Workspace-ID "";
            proxy_set_header X-DocReview-Identity-Issued-At "";
            proxy_set_header X-DocReview-Roles "";
            proxy_set_header X-DocReview-Identity-Signature "";

            proxy_ssl_server_name on;
            proxy_ssl_name ${DOCREVIEW_AUTH_SERVER_NAME};
            proxy_ssl_verify on;
            proxy_ssl_trusted_certificate /run/secrets/auth_ca_bundle;
            proxy_ssl_certificate /run/secrets/auth_client_certificate;
            proxy_ssl_certificate_key /run/secrets/auth_client_private_key;
        }

        location / {
            auth_request /_identity_authorize;
            auth_request_set $auth_principal_type $upstream_http_x_auth_principal_type;
            auth_request_set $auth_principal_id $upstream_http_x_auth_principal_id;
            auth_request_set $auth_organization_id $upstream_http_x_auth_organization_id;
            auth_request_set $auth_workspace_id $upstream_http_x_auth_workspace_id;
            auth_request_set $auth_roles $upstream_http_x_auth_roles;

            js_set $identity_issued_at trusted.issuedAt;
            js_set $identity_signature trusted.signature;

            proxy_http_version 1.1;
            proxy_pass http://docreview_python;
            proxy_request_buffering on;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 60s;

            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Request-ID $trusted_request_id;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # These assignments overwrite and therefore strip every caller value.
            proxy_set_header X-DocReview-Principal-Type $auth_principal_type;
            proxy_set_header X-DocReview-Principal-ID $auth_principal_id;
            proxy_set_header X-DocReview-Organization-ID $auth_organization_id;
            proxy_set_header X-DocReview-Workspace-ID $auth_workspace_id;
            proxy_set_header X-DocReview-Identity-Issued-At $identity_issued_at;
            proxy_set_header X-DocReview-Roles $auth_roles;
            proxy_set_header X-DocReview-Identity-Signature $identity_signature;
        }
    }

    server {
        listen 80;
        server_name ${DOCREVIEW_PUBLIC_SERVER_NAME};
        return 308 https://$host$request_uri;
    }
}
